---
// "Night flight / day flight": inverts the whole site. Dark by default.
// The choice is remembered in this browser only (localStorage).
---
<button class="toggle" type="button" aria-pressed="false" data-theme-toggle>
  <span data-theme-label>day flight</span>
</button>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const label = btn.querySelector('[data-theme-label]')!;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    btn.setAttribute('aria-pressed', String(light));
    label.textContent = light ? 'night flight' : 'day flight'; // shows what a click switches to
  };
  sync();
  btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* private mode: just don't remember */ }
    sync();
  });
</script>

<style>
  .toggle {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 50;
    font-family: var(--font-pixel); font-size: 0.8rem; letter-spacing: 0.08em;
    color: var(--text); background: var(--bg); border: 1px solid var(--line); padding: 0.5rem 0.8rem;
  }
  .toggle:hover { border-color: var(--amber); color: var(--amber); }
</style>
