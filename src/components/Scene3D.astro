---
// One 3D object. Usage:
//   <Scene3D kind="engine" label="TRK_02 0.918" model="/models/engine.glb" />
// kind: engine | airfoil | console | pass
// covers: (console only) image URLs shown on the screen
// aoa: (airfoil only) CSS selector of the angle-of-attack slider
// The drawing code is in src/lib/scene3d.ts
interface Props {
  kind: 'engine' | 'airfoil' | 'console' | 'pass';
  label?: string;
  model?: string;
  covers?: string[];
  aoa?: string;
  description: string;
}
const { kind, label = '', model, covers = [], aoa, description } = Astro.props;
---

<div class="scene" data-scene={kind} data-model={model} data-covers={JSON.stringify(covers)} data-aoa={aoa}>
  <canvas role="img" aria-label={description}></canvas>
  <span class="corner tl"></span><span class="corner tr"></span>
  <span class="corner bl"></span><span class="corner br"></span>
  <span class="label tag-label">{label}</span>
</div>

<script>
  import { initScenes } from '../lib/scene3d';
  initScenes();
</script>

<style>
  .scene { position: relative; width: 100%; max-width: 34rem; aspect-ratio: 1 / 1; margin-inline: auto; }
  canvas { width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .tag-label { position: absolute; top: -1.4rem; left: 0; }
  /* small viewfinder corners */
  .corner { position: absolute; width: 1.2rem; height: 1.2rem; border: 0 solid var(--muted); pointer-events: none; }
  .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
</style>
