---
// Homepage: hero, About (3D engine), Projects (3D console + grid), Physics EE (3D airfoil),
// Activities, Contact (3D crumpled boarding pass). All text comes from src/content/.
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Loader from '../components/Loader.astro';
import HeroFlight from '../components/HeroFlight.astro';
import SplitFlap from '../components/SplitFlap.astro';
import Scene3D from '../components/Scene3D.astro';
import { getEntry, render } from 'astro:content';
import { getProjects, getActivities, tagClass } from '../lib/projects';
import { url } from '../lib/url';

const hero = (await getEntry('site', 'hero'))!;
const about = (await getEntry('site', 'about'))!;
const skills = (await getEntry('site', 'skills'))!;
const activities = await getActivities();
const contact = (await getEntry('site', 'contact'))!;
const { Content: AboutText } = await render(about);

const projects = await getProjects();
const pad = (n: number) => String(n + 1).padStart(2, '0');

// Data for the console viewer script below
const viewerData = projects.map((p, i) => ({
  n: pad(i),
  title: p.data.title,
  status: p.data.status,
  tag: tagClass(p.data.status),
  summary: p.data.summary,
  href: url(`/projects/${p.id}/`),
}));
const covers = projects.map((p) => (p.data.cover ? url(p.data.cover) : ''));
const c = contact.data;
---

<Layout intro>
  <Loader />
  <Intro />

  <!-- HERO -->
  <div class="hero-stage">
  <HeroFlight />
  <section class="wrap hero" id="top">
    <p class="label">N 37°52′ · W 122°15′</p>
    <h1><SplitFlap text={hero.data.title ?? ''} /></h1>
    <div class="contrail" aria-hidden="true"></div>
    <p class="tagline intro-hide">{hero.data.tagline}</p>
  </section>
  </div>

  <!-- ABOUT -->
  <section class="wrap section duo" id="about">
    <Scene3D kind="engine" label="TRK_02 0.918" model={url('/models/engine.glb')} description="Animated 3D turbofan jet engine with a smoke trail" />
    <div class="prose" data-reveal>
      <h2>About me</h2>
      <AboutText />
      <h3 class="label sub">{skills.data.title}</h3>
      <ul class="chips">{skills.data.items?.map((s: string) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <!-- PROJECTS: console viewer -->
  <section class="wrap section" id="projects">
    <h2 data-reveal>Projects</h2>
    <div class="duo viewer" data-viewer data-projects={JSON.stringify(viewerData)}>
      <Scene3D kind="console" label="TRK_03 0.938" covers={covers} model={url('/models/console.glb')} description="3D handheld console showing the selected project">
        <div slot="tag" class="seg" role="group" aria-label="Project view">
          <button type="button" class="chip" data-view="console" aria-pressed="true">Console</button>
          <button type="button" class="chip" data-view="list" aria-pressed="false">List</button>
        </div>
      </Scene3D>
      <div data-reveal>
        <p class="num"><b data-v-num>01</b><span class="label"> / {pad(projects.length - 1)}</span></p>
        <h3 data-v-title class="v-title"></h3>
        <p><span class="tag" data-v-status></span></p>
        <p data-v-summary class="prose"></p>
        <p class="controls">
          <button class="btn" type="button" data-v-prev aria-label="Previous project">←</button>
          <button class="btn" type="button" data-v-next aria-label="Next project">→</button>
          <a class="btn" data-v-open href="#">Open ↗</a>
        </p>
        <p class="label">use ← → keys</p>
      </div>
    </div>

    <!-- LIST view: all projects, filterable. Hidden until you switch to it. -->
    <div data-list hidden>
    <div class="list-head">
      <div class="seg" role="group" aria-label="Project view">
        <button type="button" class="chip" data-view="console" aria-pressed="false">Console</button>
        <button type="button" class="chip" data-view="list" aria-pressed="true">List</button>
      </div>
    </div>
    <div class="filters" role="group" aria-label="Filter projects">
      {['All', 'Aerospace', 'Builds', 'Code'].map((f, i) => (
        <button class="chip" type="button" data-filter={f} aria-pressed={String(i === 0)}>{f}</button>
      ))}
    </div>
    <ul class="grid">
      {projects.map((p) => (
        <li data-cat={p.data.category}>
          <a class="card" href={url(`/projects/${p.id}/`)}>
            {p.data.cover && <img class="frame" src={url(p.data.cover)} alt="" loading="lazy" />}
            <span class="label">{p.data.flight} · {p.data.category}</span>
            <strong>{p.data.title}</strong>
            <span class={`tag ${tagClass(p.data.status)}`}>{p.data.status}</span>
          </a>
        </li>
      ))}
    </ul>
    </div>
  </section>

  <!-- ACTIVITIES (brief; the long write-ups live on /activities/) -->
  <section class="wrap section" id="activities">
    <h2 data-reveal>Activities</h2>
    <ul class="grid acts" data-reveal>
      {activities.map((a) => (
        <li>
          <a class="card" href={url(`/activities/#${a.id}`)}>
            <strong>{a.data.title}</strong>
            <span class="label">{a.data.tagline}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a class="btn" href={url('/activities/')}>Read more →</a></p>
  </section>

  <!-- CONTACT -->
  <section class="wrap section duo" id="contact">
    <Scene3D kind="pass" label="TRK_10 0.984" model={url('/models/pass.glb')} description="Crumpled 3D boarding pass" />
    <div data-reveal>
      <h2>Contact me</h2>
      <div class="ticket">
        <p class="label ticket-head">BOARDING PASS · PASSENGER OM VITANKAR</p>
        <a class="trow" href={`mailto:${c.email}`}>
          <span class="label">Email</span><span class="val">{c.email}</span><span class="go" aria-hidden="true">↗</span>
        </a>
        <a class="trow" href={c.linkedin} rel="noopener">
          <span class="label">LinkedIn</span><span class="val">{c.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span><span class="go" aria-hidden="true">↗</span>
        </a>
        <a class="btn solid wide" href={url(c.resume)} download>Download resume</a>
        <p class="label ticket-foot">DESTINATION: AEROSPACE</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from 'gsap';
  const covers: string[] = JSON.parse(document.querySelector<HTMLElement>('[data-scene="console"]')!.dataset.covers || '[]');

  // ---- Console viewer: switch the project shown on the 3D screen ----
  const viewer = document.querySelector<HTMLElement>('[data-viewer]')!;
  const items = JSON.parse(viewer.dataset.projects!);
  const q = (s: string) => viewer.querySelector<HTMLElement>(s)!;
  let i = 0;
  const show = (n: number) => {
    i = (n + items.length) % items.length;
    const it = items[i];
    q('[data-v-num]').textContent = it.n;
    q('[data-v-title]').textContent = it.title;
    q('[data-v-summary]').textContent = it.summary;
    const st = q('[data-v-status]');
    st.textContent = it.status; st.className = 'tag ' + it.tag;
    (q('[data-v-open]') as HTMLAnchorElement).href = it.href;
    dispatchEvent(new CustomEvent('console:screen', { detail: { index: i } }));
  };
  q('[data-v-prev]').addEventListener('click', () => show(i - 1));
  q('[data-v-next]').addEventListener('click', () => show(i + 1));
  let inView = false;
  new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.3 }).observe(viewer);
  addEventListener('keydown', (e) => {
    if (!inView || (e.target as HTMLElement).matches('input, textarea')) return;
    if (e.key === 'ArrowRight') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1);
  });
  show(0);


  // ---- Page transition: the console screen zooms up to fill the window, then the project page opens ----
  const openLink = q('[data-v-open]') as HTMLAnchorElement;
  openLink.addEventListener('click', (e) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || e.metaKey || e.ctrlKey || e.shiftKey) return; // normal navigation
    e.preventDefault();
    const sceneEl = viewer.querySelector('.scene') as HTMLElement;
    const r = sceneEl.getBoundingClientRect();
    const w = r.width * 0.55, h = w * 0.68; // roughly where the 3D screen sits
    const cx = r.left + r.width / 2, cy = r.top + r.height * 0.45;
    const cover = covers[i];
    const zoom = document.createElement('div');
    Object.assign(zoom.style, {
      position: 'fixed', zIndex: '200', left: cx - w / 2 + 'px', top: cy - h / 2 + 'px', width: w + 'px', height: h + 'px',
      background: `#0a0d12 ${cover ? `url(${cover}) center / cover` : ''}`, border: '2px solid #ffb000', pointerEvents: 'none',
    });
    document.body.appendChild(zoom);
    gsap.to(zoom, {
      left: 0, top: 0, width: innerWidth, height: innerHeight, borderWidth: 0, duration: 0.55, ease: 'power3.in',
      onComplete: () => { location.href = openLink.href; },
    });
  });

  // ---- Console / List switch (the buttons next to the TRK label and at the top of the list) ----
  const listEl = document.querySelector<HTMLElement>('[data-list]')!;
  const setView = (v: string) => {
    viewer.hidden = v === 'list';
    listEl.hidden = v !== 'list';
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
    try { localStorage.setItem('projectView', v); } catch { /* ignore */ }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  try { if (localStorage.getItem('projectView') === 'list') setView('list'); } catch { /* ignore */ }

  // ---- Grid filters ----
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      document.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.grid li').forEach((li) => (li.hidden = f !== 'All' && li.dataset.cat !== f));
    }),
  );
</script>

<style>
  .hero-stage { position: relative; overflow: hidden; }
  .hero { position: relative; z-index: 1; min-height: 84vh; display: flex; flex-direction: column; justify-content: center; padding-block: 4rem; }
  h1 { font-size: clamp(1.5rem, 6.5vw, 4.2rem); margin: 0.75rem 0 1rem; font-weight: 400; }
  /* thin amber line under the name; grows in when the intro ends */
  .contrail {
    height: 2px; max-width: 30rem; margin-bottom: 1.25rem; transform-origin: left;
    background: linear-gradient(90deg, var(--amber), transparent); transition: transform 0.9s ease-out;
  }
  html[data-intro='play'] .contrail { transform: scaleX(0); }
  .tagline { font-size: 1.2rem; max-width: 36rem; }
  h2 { font-size: clamp(1.4rem, 4vw, 2.2rem); margin: 0 0 1.25rem; font-weight: 400; }
  .sub { margin: 1.5rem 0 0; font-weight: 400; }

  .viewer { margin-block: 3rem 2rem; }
  .viewer[hidden], [data-list][hidden] { display: none; }
  .seg { display: flex; gap: 0.35rem; }
  .list-head { margin: 2rem 0 1.25rem; }
  .num b { font-family: var(--font-pixel); font-size: clamp(2.5rem, 8vw, 4rem); color: var(--amber); font-weight: 400; }
  .v-title { font-family: var(--font-sans); color: var(--text); font-size: 1.4rem; margin: 0.25rem 0 0.75rem; letter-spacing: 0; }
  .controls { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1.25rem 0 0.75rem; }
  .btn.solid { background: var(--amber); color: var(--bg); }
  .btn.solid:hover { background: transparent; color: var(--amber); }

  .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .chip { font-family: var(--font-mono); font-size: 0.8rem; padding: 0.35rem 0.8rem; color: var(--text); background: transparent; border: 1px solid var(--line); }
  .chip[aria-pressed='true'] { border-color: var(--amber); color: var(--amber); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .grid li[hidden] { display: none; }
  .card { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; text-decoration: none; color: var(--text); height: 100%; }
  .card:hover strong { color: var(--amber); }
  .acts .card { padding: 1rem; border: 1px solid var(--line); background: var(--panel); }
  .card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }

  /* contact card: one clean boarding-pass style panel */
  .ticket { max-width: 30rem; background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--amber); padding: 1.25rem 1.5rem 1rem; margin-top: 1.25rem; }
  .ticket-head { margin: 0 0 0.9rem; }
  .ticket-foot { margin: 1rem 0 0; padding-top: 0.8rem; border-top: 1px dashed var(--line); }
  .trow { display: grid; grid-template-columns: 7rem 1fr auto; gap: 1.5rem; align-items: baseline; padding: 0.85rem 0; border-top: 1px dashed var(--line); text-decoration: none; color: var(--text); }
  .trow .val { font-family: var(--font-mono); font-size: 0.9rem; overflow-wrap: anywhere; }
  .trow .go { color: var(--amber); }
  .trow:hover .val, .trow:hover .go { color: var(--amber); }
  .btn.wide { display: block; width: 100%; text-align: center; margin-top: 0.9rem; }
</style>
